{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source": {
      "enum": [
        "user_rule",
        "inferred_preference",
        "model_guess",
        "manual"
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "mock": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "mock"
      ],
      "additionalProperties": false
    },
    "target_state": {
      "type": "object",
      "properties": {
        "object_type": {
          "enum": [
            "wall",
            "window",
            "blind",
            "sliding_panel",
            "generic"
          ]
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "joint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "target_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "intent": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "object_type",
        "object_id",
        "joint",
        "target_value",
        "intent"
      ],
      "additionalProperties": false
    },
    "rationale": {
      "type": "string",
      "maxLength": 4000
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "user_preferences_used": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 64
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  },
  "required": [
    "schema_version",
    "id",
    "source",
    "provider",
    "target_state",
    "rationale",
    "uncertainty",
    "user_preferences_used",
    "created_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tinker:schema:GoalProposal",
  "title": "GoalProposal",
  "$defs": {
    "Pose": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "position",
        "rotation"
      ],
      "additionalProperties": false,
      "title": "Pose"
    },
    "Joint": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "prismatic",
            "revolute"
          ]
        },
        "axis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "max_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_force": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "kind",
        "axis",
        "anchor",
        "lower",
        "upper",
        "max_speed",
        "max_force",
        "value"
      ],
      "additionalProperties": false,
      "title": "Joint"
    },
    "SceneObject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "host_id": {
          "type": "string",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "type": {
          "enum": [
            "room",
            "floor",
            "wall",
            "window",
            "blind",
            "sliding_panel",
            "obstacle",
            "generic"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "geometry_ref": {
          "type": "string",
          "maxLength": 256
        },
        "collision": {
          "type": "boolean"
        },
        "joints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Joint"
          },
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "host_id",
        "name",
        "type",
        "parent_id",
        "pose",
        "size",
        "collision",
        "joints"
      ],
      "additionalProperties": false,
      "title": "SceneObject"
    },
    "Constraint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "no_go_volume",
            "travel_bounds",
            "max_speed",
            "dependency"
          ]
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 64
        },
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "object_ids"
      ],
      "additionalProperties": false,
      "title": "Constraint"
    },
    "Violation": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "collision",
            "joint_limit",
            "speed_limit",
            "force_limit",
            "no_go_volume",
            "unreachable_goal",
            "missing_geometry",
            "stale_scene",
            "not_applicable"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "t": {
          "type": [
            "number",
            "null"
          ]
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 64
        }
      },
      "required": [
        "code",
        "message",
        "t",
        "object_ids"
      ],
      "additionalProperties": false,
      "title": "Violation"
    },
    "Sample": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0
        },
        "poses": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Pose"
          },
          "maxProperties": 64
        },
        "action": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "event": {
          "enum": [
            "sample",
            "edit",
            "undo",
            "redo"
          ]
        }
      },
      "required": [
        "t",
        "poses",
        "action",
        "event"
      ],
      "additionalProperties": false,
      "title": "Sample"
    }
  }
}
